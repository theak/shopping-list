# The builder only needs the crate sources + the embedded frontend assets
# (Cargo.toml, Cargo.lock, src/, templates/, static/). Everything below is
# build output, dev/CI/test tooling, or VCS metadata.
target
.git
.github
.gitignore
.dockerignore
node_modules
test
package.json
package-lock.json
docker-compose.yml
README.md
.env
.DS_Store
